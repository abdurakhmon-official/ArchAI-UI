# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# api/geometry dan nusxa. Yagona manba — api/geometry/, lekin `ui`
# alohida repozitoriyada va Vercel `../api` ni ko'rmaydi, shuning
# uchun nusxa COMMIT QILINADI. Geometriyani o'zgartirgach
# `npm run sync:geometry` yuriting va natijani ham commit qiling.
# `predev` va `prebuild` uni har safar qayta yaratadi
